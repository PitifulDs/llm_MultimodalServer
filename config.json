{
  "http_port": 8080,
  "default_model": "qwen3.5-2b",
  "worker_threads": 4,
  "max_model_queue": 64,
  "max_session_pending": 64,
  "max_queue_wait_ms": 2000,
  "llama_model_path": "models/qwen3.5/Qwen3.5-2B-Q4_K_M.gguf",
  "models": {
    "qwen2.5-1.5b": {
      "backend": "local",
      "engine": "llama",
      "model_path": "models/qwen2.5-1.5b/qwen2.5-1.5b-instruct-q4_0.gguf"
    },
    "qwen3.5-2b": {
      "default_backend": "local",
      "capabilities": ["chat", "embeddings", "rerank"],
      "backends": {
        "local": {
          "engine": "llama",
          "model_path": "models/qwen3.5/Qwen3.5-2B-Q4_K_M.gguf",
          "capabilities": ["chat", "embeddings", "rerank"]
        }
      }
    },
    "llama": {
      "backend": "local",
      "engine": "llama",
      "model_path": "models/qwen3.5/Qwen3.5-2B-Q4_K_M.gguf"
    }
  },
  "llama_n_ctx": 4096,
  "llama_n_threads": 4,
  "llama_n_threads_batch": 4,
  "kv_reset_margin": 256,
  "default_max_tokens": 512,
  "rag_index_path": "data/rag_index.sqlite",
  "rag_vector_index_path": "data/rag_faiss.index",
  "rag_chunk_metadata_path": "data/rag_chunks.jsonl",
  "rag_embeddings_path": "data/rag_embeddings.npy",
  "rag_id_map_path": "data/rag_id_map.json",
  "rag_default_top_k": 6,
  "rag_default_mode": "lexical",
  "rag_default_fusion": "rrf",
  "rag_enable_neighbor_expand": 1,
  "rag_max_neighbor_count": 1,
  "rag_enable_retrieval_debug_api": 1,
  "experimental_agent_api_enabled": 0,
  "experimental_rag_api_enabled": 0,
  "rag_max_context_chars": 6000,
  "serving_backend": "local",
  "stackflow_host": "127.0.0.1",
  "stackflow_port": 10001,
  "stackflow_unit": "llm",
  "stackflow_timeout_ms": 180000,
  "stackflow_infer_timeout_ms": 180000,
  "stackflow_reuse_work_id": 1,
  "stackflow_serialize_reuse": 1,
  "stackflow_max_concurrency": 2,
  "warmup_model": 0,
  "session_persist_redis": 0,
  "redis_host": "127.0.0.1",
  "redis_port": 6379,
  "redis_db": 0,
  "session_redis_prefix": "edge:session:",
  "session_redis_ttl_seconds": 1800,
  "redis_timeout_ms": 1000
}
